# ODCMP environment configuration template.
# Copy to `.env` and fill in real values. Never commit the real .env file.

NODE_ENV=development

# Port the Express API server listens on.
PORT=4000

# Neon Postgres connection string (Render backend / local dev).
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: separate database for tests. Use Neon's unpooled host (no "-pooler"
# in the hostname) so per-schema search_path settings stay on one connection.
# DATABASE_URL_TEST=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/dbname_test?sslmode=require

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-secret

# Comma separated list of allowed browser origins for cross-origin requests.
# Local dev default; for Render + Cloudflare Pages include your Pages origin(s).
CORS_ORIGINS=http://localhost:5173

# Frontend build-time API base URL for Cloudflare Pages (Vite reads VITE_* vars).
# Example: https://your-render-api.onrender.com
# VITE_API_URL=http://localhost:4000

# Where generated PDF reports are written. Must be a project-local directory.
REPORTS_DIR=./reports/generated

# Timezone used to display timestamps (project default).
TZ_DISPLAY=Africa/Lusaka

# Temporary testing switch. When true, a visitor may run multiple free checks.
# Set to false (the default when unset) to enforce one free service per visitor.
FREE_CHECKS_UNLIMITED=false

# Bootstrap: provide admin credentials when running `npm run db:bootstrap`.
# ODCMP_ADMIN_EMAIL=admin@example.com
# ODCMP_ADMIN_PASSWORD=replace-with-strong-password
# NEVER hardcode a password in source code.
