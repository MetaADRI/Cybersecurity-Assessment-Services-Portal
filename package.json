{
  "name": "odcmp",
  "version": "0.1.0",
  "private": true,
  "description": "OpenDefenders Cybersecurity Management Platform (ODCMP) - health scores, remediation tracking and reporting",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n server,client -c blue,green \"node node_modules/tsx/dist/cli.mjs watch server/src/main.ts\" \"node node_modules/vite/bin/vite.js\"",
    "dev:server": "node node_modules/tsx/dist/cli.mjs watch server/src/main.ts",
    "dev:client": "node node_modules/vite/bin/vite.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node node_modules/vite/bin/vite.js build",
    "build:server": "node node_modules/esbuild/bin/esbuild server/src/main.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist-server/main.js --log-level=warning",
    "start": "node dist-server/main.js",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/tsx/dist/cli.mjs scripts/e2e-setup.ts && node node_modules/@playwright/test/cli.js test",
    "db:migrate": "node node_modules/tsx/dist/cli.mjs server/src/database/migrate-cli.ts",
    "db:bootstrap": "node node_modules/tsx/dist/cli.mjs server/src/database/bootstrap-cli.ts",
    "db:seed": "node node_modules/tsx/dist/cli.mjs server/src/database/seed-cli.ts",
    "db:reset": "node node_modules/tsx/dist/cli.mjs server/src/database/reset-cli.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.525.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "react-router-dom": "^7.6.3",
    "recharts": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
